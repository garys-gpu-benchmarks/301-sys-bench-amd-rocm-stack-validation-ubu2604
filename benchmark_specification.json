  },
  {
    "field_name": "Primary Record Granularity",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "one CSV row per tool probe (seven checks)"
  },
  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sample_index,check_name,rc,rocm_package_mismatch_count,kernel_release_mismatch_count,kernel_mismatch_count,driver_mismatch_count,driver_version_available,driver_compliance_percent,permission_error_count\n0,rocminfo,0,0,0,0,0,1,100,0"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --kernel-version 7.0.0 --driver-version 7.1.9 --rocm-version 10.1.0 --required-packages amdrocm-base10.1,amdrocm-amdsmi10.1 --permissions-check true --output-format csv"
  },
